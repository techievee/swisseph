{"nodes": [{"id": "_claude_skills_graphify_references_exports", "label": "graphify Reference: Extra Exports and Benchmark", "file_type": "document", "source_file": ".claude/skills/graphify/references/exports.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_claude_skills_graphify_references_exports_wiki", "label": "Wiki Export (--wiki)", "file_type": "concept", "source_file": ".claude/skills/graphify/references/exports.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Builds an agent-crawlable wiki (index.md + one article per community). Must run before Step 9 cleanup so .graphify_labels.json is still available."}, {"id": "_claude_skills_graphify_references_exports_neo4j", "label": "Neo4j Export (--neo4j / --neo4j-push)", "file_type": "concept", "source_file": ".claude/skills/graphify/references/exports.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Generates a Cypher file (cypher.txt) for manual import or pushes directly to a running Neo4j over bolt://. Uses MERGE, so it is safe to re-run without creating duplicates."}, {"id": "_claude_skills_graphify_references_exports_falkordb", "label": "FalkorDB Export (--falkordb / --falkordb-push)", "file_type": "concept", "source_file": ".claude/skills/graphify/references/exports.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Statements are OpenCypher, but FalkorDB's GRAPH.QUERY runs one statement at a time (no bulk script import like Neo4j's cypher-shell), so prefer --falkordb-push over the portable cypher.txt artifact. Default target graph is 'graphify'; uses MERGE."}, {"id": "_claude_skills_graphify_references_exports_mcp", "label": "MCP Server (--mcp, graphify.serve)", "file_type": "concept", "source_file": ".claude/skills/graphify/references/exports.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Starts a stdio MCP server exposing query_graph, get_node, get_neighbors, get_community, god_nodes, graph_stats, shortest_path so other agents can query the graph live. Claude Desktop can't run $(...) and system python3 can't import graphify under uv tool, so the config must use the absolute interpreter path from .graphify_python."}, {"id": "_claude_skills_graphify_references_exports_benchmark", "label": "Token-Reduction Benchmark (Step 8)", "file_type": "concept", "source_file": ".claude/skills/graphify/references/exports.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Runs only when total_words exceeds 5,000. For small corpora it is skipped: the graph's value is structural clarity, not token compression."}], "edges": [{"source": "_claude_skills_graphify_references_exports", "target": "_claude_skills_graphify_references_exports_wiki", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/graphify/references/exports.md", "source_location": null, "weight": 1.0}, {"source": "_claude_skills_graphify_references_exports", "target": "_claude_skills_graphify_references_exports_neo4j", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/graphify/references/exports.md", "source_location": null, "weight": 1.0}, {"source": "_claude_skills_graphify_references_exports", "target": "_claude_skills_graphify_references_exports_falkordb", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/graphify/references/exports.md", "source_location": null, "weight": 1.0}, {"source": "_claude_skills_graphify_references_exports", "target": "_claude_skills_graphify_references_exports_mcp", "relation": "references", "confiden