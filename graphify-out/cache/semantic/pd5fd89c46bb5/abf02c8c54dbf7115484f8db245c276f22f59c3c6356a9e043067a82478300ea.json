{"nodes": [{"id": "_claude_skills_graphify_skill", "label": "graphify SKILL.md \u2014 Full Pipeline Runbook", "file_type": "document", "source_file": ".claude/skills/graphify/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_claude_skills_graphify_skill_pipeline", "label": "graphify Full Pipeline (Steps 0-9)", "file_type": "concept", "source_file": ".claude/skills/graphify/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Turns any folder of files into a navigable knowledge graph with community detection, an honest audit trail, and three outputs: interactive HTML, GraphRAG-ready JSON, and GRAPH_REPORT.md. Persistent across sessions."}, {"id": "_claude_skills_graphify_skill_ast_extraction", "label": "Part A \u2014 Structural (AST) Extraction", "file_type": "concept", "source_file": ".claude/skills/graphify/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Deterministic and free: code is extracted structurally with no LLM and no API key. A code-only corpus skips semantic extraction entirely. Runs in parallel with the semantic subagents to save 5-15s on large corpora."}, {"id": "_claude_skills_graphify_skill_semantic_extraction", "label": "Part B \u2014 Semantic Extraction via Parallel Subagents", "file_type": "concept", "source_file": ".claude/skills/graphify/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "LLM-based, costs tokens; only needed for docs/papers/images. Files are split into 20-25 file chunks, one general-purpose subagent per chunk, all dispatched in a single message so they run in parallel. Gemini is used only if GEMINI_API_KEY/GOOGLE_API_KEY is already set; otherwise the host agent is the LLM. Never prompts for ANTHROPIC/OPENAI keys."}, {"id": "_claude_skills_graphify_skill_extraction_cache", "label": "Semantic Extraction Cache", "file_type": "concept", "source_file": ".claude/skills/graphify/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Cache entries are attributed to the extraction-spec prompt file: when a graphify upgrade changes the prompt, entries produced by the old prompt are re-extracted instead of replayed (#1939). The cached file is always rewritten or deleted so a stale .graphify_cached.json is never merged (#1392)."}, {"id": "_claude_skills_graphify_skill_build_cluster", "label": "Step 4 \u2014 Build, Cluster, God Nodes, Report", "file_type": "concept", "source_file": ".claude/skills/graphify/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "build_from_json + cluster + god_nodes + surprising_connections + report. Guards before any write: an empty extraction must not clobber a good graph.json (#1392), and the #479 shrink-guard refuses to write a graph.json smaller than the existing one \u2014 an intentional shrink requires a full build with --force."}, {"id": "_claude_skills_graphify_skill_graph_health_check", "label": "Step 4.5 \u2014 Graph Health Check", "file_type": "concept", "source_file": ".claude/skills/graphify/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Non-destructive read-only diagnostic before labeling that surfaces edge collapse, dangling/missing endpoints, and self-loops \u2014 the silent-corruption modes of incremental updates and AST/LLM id mismatches. Never aborts, but warnings must be surfaced (Honesty Rules)."}, {"id": "_claude_skills_graphify_skill_community_labeling", "label": "Step 5 \u2014 Community Labeling", "file_type": "concept", "source_file": ".claude/skills/graphify/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The LLM reads the analysis file and writes 2-5 word plain-language community names; labels affect suggested-question phrasing and are re-exported so graph.json nodes carry the curated community_name (#2490)."}, {"id": "_claude_skills_graphify_skill_manifest_cost", "label": "Step 9 \u2014 Manifest, Cost Tracking, Cleanup", "file_type": "concept", "source_file": ".claude/skills/graphify/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Only semantic files (docs/papers/images) that ACTUALLY produced output are stamped in the manifest: a file whose chunk failed must stay unstamped so the next --update re-queues it, or its content is lost forever (#2015). Stale semantic_hash is cleared for dispatched-but-unstamped files (#1948). Manifest keys are relativized to the scan root so the manifest is portable across clones/machines (#1417). A cumulative cost tracker in cost.json shows per-run and all-time token usage."}, {"id": "_claude_skills_graphify_skill_honesty_rules", "label": "graphify Honesty Rules", "file_type": "concept", "source_file": ".claude/skills/graphify/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Never invent an edge (use AMBIGUOUS if unsure); never skip the corpus check warning; always show token cost; never hide cohesion scores behind symbols; never run HTML viz on >5,000 nodes without warning."}, {"id": "_claude_skills_graphify_skill_fast_path", "label": "Fast Path \u2014 Query an Existing graph.json", "file_type": "concept", "source_file": ".claude/skills/graphify/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "If graphify-out/graph.json exists and the request is a natural-language codebase question (not a rebuild command), skip Steps 1-5 and run `graphify query` immediately \u2014 do not detect, do not check corpus size. The graph is already built; the agent's job after the pipeline is to be the guide, not a one-shot report."}, {"id": "_claude_skills_graphify_skill_interpreter_guard", "label": "Interpreter Guard (.graphify_python)", "file_type": "concept", "source_file": ".claude/skills/graphify/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Resolves the correct Python interpreter (uv tool, pipx shebang, venv, or system), persists it to graphify-out/.graphify_python, and re-resolves it before any subcommand if the file was deleted (e.g. user deleted graphify-out/)."}], "edges": [{"source": "_claude_skills_graphify_skill", "target": "_claude_skills_graphify_references_github_and_merge", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/graphify/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "_claude_skills_graphify_skill", "target": "_claude_skills_graphify_references_transcribe", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/graphify/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "_claude_skills_graphify_skill", "target": "_claude_skills_graphify_references_extraction_spec", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/graphify/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "_claude_skills_graphify_skill", "target": "_claude_skills_graphify_references_update", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/graphify/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "_claude_skills_graphify_skill", "target": "_claude_skills_graphify_references_add_watch", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "sour