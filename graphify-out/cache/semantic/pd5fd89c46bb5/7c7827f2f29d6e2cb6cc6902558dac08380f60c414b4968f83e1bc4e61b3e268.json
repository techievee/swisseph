{"nodes": [{"id": "_claude_skills_graphify_references_hooks", "label": "graphify Reference: Commit Hook and CLAUDE.md Integration", "file_type": "document", "source_file": ".claude/skills/graphify/references/hooks.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_claude_skills_graphify_references_hooks_commit_hook", "label": "Post-Commit Hook (graphify hook install)", "file_type": "concept", "source_file": ".claude/skills/graphify/references/hooks.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "After every git commit the hook detects changed code files via `git diff HEAD~1`, re-runs AST extraction on just those, and rebuilds graph.json and GRAPH_REPORT.md \u2014 no background process, no LLM. Doc/image changes are ignored (manual /graphify --update). If a post-commit hook already exists, graphify appends to it rather than replacing it."}, {"id": "_claude_skills_graphify_references_hooks_claude_md_integration", "label": "graphify claude install \u2014 Native CLAUDE.md Integration", "file_type": "concept", "source_file": ".claude/skills/graphify/references/hooks.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Writes a `## graphify` section to the project's local CLAUDE.md instructing Claude to check the graph before answering codebase questions and rebuild after code changes, making graphify always-on in Claude Code sessions with no manual /graphify needed (removable via `graphify claude uninstall`)."}], "edges": [{"source": "_claude_skills_graphify_references_hooks", "target": "_claude_skills_graphify_references_hooks_commit_hook", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/graphify/references/hooks.md", "source_location": null, "weight": 1.0}, {"source": "_claude_skills_graphify_references